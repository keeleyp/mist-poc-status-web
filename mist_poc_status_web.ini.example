# One line per Mist cloud: cloud = api_token
# The cloud can be written as api.eu.mist.com, a short form (eu, gc3, us),
# or the portal URL (https://manage.eu.mist.com). Tokens only work on the
# cloud they were made on. For several POCs on the same cloud with separate
# keys, put the tokens on one line separated by commas.
# Every org each key can see is reported (MSP access covers all its orgs).
[clouds]
api.mist.com = YOUR_GLOBAL01_TOKEN_HERE
api.eu.mist.com = YOUR_EU_TOKEN_HERE
gc3 = YOUR_GC3_TOKEN_1_HERE, YOUR_GC3_TOKEN_2_HERE

[settings]
# Workbook that holds the run history, trends, POC details and notes.
# Relative paths are relative to this .ini. It uses the same layout as the
# text version (mist-poc-status-report), so you can point both at one file.
output_file = mist_poc_status.xlsx
# Optional comma-separated org names or org IDs to leave out of the report.
exclude_orgs =
# Audit log entries by the owners of the API keys above are never counted,
# so your own logins and API calls don't make a POC look used. Add any other
# internal admins here (comma-separated emails, or exact admin names).
exclude_admins =

# Optional - only needed if you're behind a TLS-inspecting proxy (e.g.
# Zscaler). Delete this whole section, or leave the values blank, to use
# normal system defaults (certifi's CA store, and the HTTP_PROXY /
# HTTPS_PROXY / NO_PROXY environment variables if set).
[network]
# Path to a PEM file with your proxy's root CA certificate (or a bundle
# that includes it), so TLS verification succeeds against its inspected
# connections. Most Zscaler deployments can export this from the client
# app, or your IT team will have it.
ca_bundle =
# Only set this to false if you have no way to obtain the proxy's CA
# certificate. This disables TLS certificate verification entirely and is
# not recommended.
verify_ssl = true
# Explicit proxy overrides - usually unnecessary, since requests already
# honors HTTP_PROXY / HTTPS_PROXY / NO_PROXY from the environment.
http_proxy =
https_proxy =

[web]
# Address and port for the web app. 127.0.0.1 = this machine only. Use
# 0.0.0.0 to allow other machines (e.g. on a Raspberry Pi) - and then set a
# username and password below.
host = 127.0.0.1
port = 5020
# Optional login (HTTP basic auth). Leave both blank for no login.
username =
password =
